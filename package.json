{
  "name": "salle-de-jeux",
  "version": "1.1.0",
  "private": true,
  "description": "Deux jeux multijoueurs, un accès commun : Dessine et devine et Duel d’étoiles.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node scripts/dev.js",
    "test": "tsx --test test/*.test.ts games/dessin/test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "build": "tsc -p tsconfig.server.json && node scripts/build-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p games/dessin/tsconfig.json",
    "lint": "eslint --no-config-lookup --config eslint.config.mjs src client shared server.ts games/dessin/server games/dessin/client games/dessin/shared",
    "test:e2e": "node test/fusion.e2e.cjs && node test/movement.e2e.cjs && node test/e2e.cjs && node test/guests.e2e.cjs && node test/restart.e2e.cjs && node test/restart.e2e.cjs --replica",
    "test:e2e:drawing": "npm --prefix games/dessin run test:e2e"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "@playwright/test": "^1.64.0"
  }
}
