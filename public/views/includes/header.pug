a.skip-link(href='#contenu') Aller au contenu
header.navbar.arcade-system(class=authCompact ? 'auth-header' : undefined)
  .navbar-brand
    a.brand(href=joueur ? '/salon' : '/jouer' aria-label='Duel d’étoiles en ligne, accueil')
      span.brand-icon(aria-hidden='true') ✦
      span Duel d’étoiles en ligne
    button.navbar-burger(type='button' data-target='navMenubd' aria-controls='navMenubd' aria-expanded='false' aria-label='Ouvrir le menu')
      span(aria-hidden='true')
      span(aria-hidden='true')
      span(aria-hidden='true')
  if joueur && joueur.kind === 'guest'
    .guest-access
      span Invité · #{joueur.nomUtilisateur}
      form(action='/utilisateur/deconnexion' method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        button(type='submit') Quitter la session invitée
  nav#navMenubd.navbar-menu(aria-label='Commandes de l’arcade')
    .navbar-start
      if joueur
        a.navbar-item(href='/salon') Salons de jeu
        a.navbar-item(href='/salon/discussion&jeu') Discussion
        if joueur.kind === 'account'
          a.navbar-item(href='/stats') Historique des scores
        else
          a.navbar-item(href='/connexion') Compte et scores durables
      else
        a.navbar-item(href='/jouer') Jouer par pseudo
        a.navbar-item(href='/connexion') Connexion compte
        a.navbar-item(href='/inscription') Créer un compte
    if joueur && joueur.kind === 'account'
      .navbar-end
        a.navbar-item(href='/profil') Profil · #{joueur.nomUtilisateur}
        form.navbar-item(action='/utilisateur/deconnexion' method='post')
          input(type='hidden' name='_csrf' value=csrfToken)
          button.button.is-outlined(type='submit') Déconnexion
#access-ended.notification.is-danger.cacher(role='alert' tabindex='-1')
  p#access-ended-message
  a(href='/jouer') Reprendre l’accès au jeu
  | #{' · '}
  a(href='/connexion') Se reconnecter au compte
