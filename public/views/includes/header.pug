a.skip-link(href='#contenu') Aller au contenu
header.navbar.arcade-system
  .navbar-brand
    a.brand(href='/salon' aria-label='Duel d’étoiles en ligne, accueil')
      span.brand-icon(aria-hidden='true') ✦
      span Duel d’étoiles en ligne
    button.navbar-burger(type='button' data-target='navMenubd' aria-controls='navMenubd' aria-expanded='false' aria-label='Ouvrir le menu')
      span(aria-hidden='true')
      span(aria-hidden='true')
      span(aria-hidden='true')
  nav#navMenubd.navbar-menu(aria-label='Commandes de l’arcade')
    .navbar-start
      if utilisateur
        a.navbar-item(href='/salon') Salons de jeu
        a.navbar-item(href='/salon/discussion&jeu') Discussion
        a.navbar-item(href='/stats') Historique des scores
      else
        a.navbar-item(href='/connexion') Connexion
        a.navbar-item(href='/inscription') Nouveau joueur
    if utilisateur
      .navbar-end
        a.navbar-item(href='/profil') Profil · #{utilisateur.nomUtilisateur}
        form.navbar-item(action='/utilisateur/deconnexion' method='post')
          input(type='hidden' name='_csrf' value=csrfToken)
          button.button.is-outlined(type='submit') Déconnexion
