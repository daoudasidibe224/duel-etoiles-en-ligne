if typeof erreurs !== 'undefined'
  .notification.is-warning(role='alert')
    each message in erreurs
      p= message
if msg_succes && msg_succes.length
  .notification.is-success(role='status')= msg_succes.join(' ')
if msg_erreur && msg_erreur.length
  .notification.is-danger(role='alert')= msg_erreur.join(' ')
if error && error.length
  .notification.is-danger(role='alert')= error.join(' ')
