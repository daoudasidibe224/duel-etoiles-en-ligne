doctype html
html(lang='fr')
  head
    meta(charset='utf-8')
    title La Salle de jeux · Dessine et devine & Duel d’étoiles
    meta(name='session-key' content=sessionState ? sessionState.key : "visitor")
    meta(name='identity-key' content=sessionState ? sessionState.identity : "visitor")
    meta(name='session-expires' content=sessionState ? sessionState.expiresAt : 0)
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='description' content='Dessinez entre amis ou défiez un adversaire sous les étoiles. Deux jeux, un accès par pseudo ou par compte.')
    link(rel='icon' href='/images/favicon.svg')
    link(rel='stylesheet' href='/styles/style.css')
    if typeof currentPath !== 'undefined' && currentPath.startsWith('/salon/salonDeJeu/')
      link(rel='stylesheet' href='/styles/jeu.css')
    link(rel='stylesheet' href='/styles/hub.css')
