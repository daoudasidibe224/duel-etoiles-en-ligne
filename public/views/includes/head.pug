doctype html
html(lang='fr')
  head
    meta(charset='utf-8')
    title Duel d’étoiles en ligne | Arcade multijoueur
    meta(name='session-key' content=sessionState ? sessionState.key : "visitor")
    meta(name='identity-key' content=sessionState ? sessionState.identity : "visitor")
    meta(name='session-expires' content=sessionState ? sessionState.expiresAt : 0)
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='description' content='Une partie à deux, des étoiles à ramasser et un salon pour discuter.')
    link(rel='icon' href='/images/favicon.svg')
    link(rel='stylesheet' href='/styles/style.css')
