include includes/head.pug
body
  include includes/header.pug
  main#contenu.page-shell
    header.page-heading
      p.eyebrow Entre deux parties
      h1.title Le salon de discussion
      a(href='/salon') ← Retour aux parties
    .chat-layout.panel
      aside
        h2 En ligne
        #listeUtilisateurs.nomCapital
      section.chat-main(aria-label='Discussion générale')
        .chatBox(role='log' aria-live='polite' aria-label='Messages')
        p#chat-status.muted(role='status') Connexion…
        form#envoyerMessage.form
          label.label(for='message') Votre message
          .message-compose
            input#message.input(name='message' placeholder='Écrivez un message…' required maxlength='1000' autocomplete='off')
            button.button.is-primary(type='submit') Envoyer
  script(src='/socket.io/socket.io.js')
  script(src='/js/discussionClient.js' defer)
  include includes/footer.pug
