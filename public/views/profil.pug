include includes/head.pug
body
  include includes/header.pug
  main#contenu.page-shell.narrow
    header.page-heading
      p.eyebrow Votre identité dans le jeu
      h1.title Mon profil
      p.muted= utilisateur.email
    section.panel
      include includes/messages.pug
      form(action='/utilisateur/editer-profil' method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        .field
          label.label(for='nouveauNomUtilisateur') Pseudo
          input#nouveauNomUtilisateur.input(type='text' name='nouveauNomUtilisateur' value=utilisateur.nomUtilisateur required minlength='3' maxlength='24' pattern='(?:[A-Za-z0-9_]|-){3,24}' autocomplete='username')
          p.help 3 à 24 lettres, chiffres, tirets ou tirets bas.
        button.button.is-primary(type='submit') Enregistrer
  include includes/footer.pug
