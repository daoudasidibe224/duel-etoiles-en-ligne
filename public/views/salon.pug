include includes/head.pug
body
  include includes/header.pug
  main#contenu.page-shell.lobby-page
    header.page-heading.lobby-heading
      div
        p.eyebrow Les salons
        h1.title Choisir une partie
        p.muted Bienvenue #{joueur.nomUtilisateur}. La prochaine manche vous attend.
      .match-facts(aria-label='Format des parties')
        span 2 joueurs
        span 90 secondes
        span 3 étapes
    include includes/messages.pug
    if recoveredRoom
      p.notification(role="status")= recoveredRoom.recoveryNotice
      a.button.is-outlined(href="/salon/salonDeJeu/" + recoveredRoom.id) Reprendre votre salon
    .lobby-layout
      aside.lobby-launch(aria-labelledby='nouvelle-partie-titre')
        img.arena-preview(src='/images/arena-preview.jpg' alt='Deux pilotes sur un terrain lunaire.' width='960' height='540')
        .launch-content
          p.eyebrow Votre propre salon
          h2#nouvelle-partie-titre Invitez un adversaire
          p.muted Ouvrez une partie et partagez son lien. Vous donnez le départ quand vous êtes deux.
          form.lancerJeuForm(action='/salon/salonDeJeu/room' method='post')
            input(type='hidden' name='_csrf' value=csrfToken)
            button.button.is-primary.is-fullwidth(type='submit') Ouvrir une partie →
          if joueur.kind === 'guest'
            p.help Votre score invité reste visible en fin de manche. #[a(href='/inscription') Créer un compte] pour garder vos prochaines parties.
      section.lobby-games(aria-labelledby='parties-titre')
        .panel-heading-row
          h2#parties-titre Parties disponibles
          span#connection-status.connection-status(role='status' data-state='loading') Connexion…
        .partieDisponible(aria-live='polite')
          .lobby-loading
            span.loading-dot(aria-hidden='true')
            p Recherche des salons…
    section.lobby-guide(aria-labelledby='regles-titre')
      div
        h2#regles-titre Une manche, trois étapes
        p.muted Ramassez les étoiles. Elles tombent de plus en plus vite pendant les 90 secondes.
      .guide-item
        span.guide-symbol(aria-hidden='true') ← →
        div
          h3 Gardez le contrôle
          p ← → pour vous déplacer, ↑ pour sauter. Commandes tactiles disponibles.
      .guide-item
        span.guide-symbol(aria-hidden='true') ✦
        div
          h3 Ramassez les bonus
          p Accélération, points doublés, bouclier ou aimant : ils s’activent tout seuls. Évitez les obstacles !
      a.discussion-link(href='/salon/discussion&jeu') Retrouvez les joueurs dans la discussion →
  script(src='/js/salonClient.js' defer)
  include includes/footer.pug
