include includes/head.pug
body.game-body
  a.skip-link(href='#contenu') Aller au jeu
  main#contenu.game-page
    .game-topline
      a.game-brand(href='/salon') ✦ Duel d’étoiles
      span Salon de #{nomDuSalon}
    p#room-recovery.recovery-notice(role='status' hidden)
    #chargement(role='status') Connexion à la partie…
    #airDeJeu
      section.arena-shell(aria-label='Partie de Duel d’étoiles')
        header.arena-toolbar
          h1 Course cosmique
          .game-toolbar
            button#share-room.button.is-outlined(type='button' aria-label='Copier l’invitation') Inviter
            button#sound-toggle.button.is-outlined(type='button' aria-pressed='false') Activer le son
            button#leave-game.button.is-outlined(type='button') Quitter la partie
        #game-hud.game-hud(role='group' aria-label='Joueurs et durée prévue')
          .hud-player#self-player(data-tone='amber')
            span.player-avatar(aria-hidden='true')
            .player-name
              small Vous
              span#self-name Vous
            output#self-score(aria-label='Votre score') 0
          .hud-timer
            span#timer-label Durée prévue
            span#countdown 1:30
          .hud-player#other-player(data-tone='mint')
            span.player-avatar(aria-hidden='true')
            .player-name
              small Adversaire
              span#other-name Place libre
            output#other-score(aria-label='En attente du second joueur') —
        .arena-strip
          .stage-hud
            p#stage-name Étape 1 / 3 · Échauffement
            progress#stage-progress(value='0' max='90' aria-label='Progression de la manche')
          .bonus-readout
            img#bonus-icon(src='/images/items/shield.svg' alt='' hidden width='26' height='32')
            p#bonus-status Attrapez un bonus : il s’active tout seul.
          p#bonus-feedback(role='status' aria-live='polite')
        .arena-viewport
          #arena-waiting.arena-waiting
            img(src='/images/arena-preview.jpg' alt='' width='960' height='540')
          canvas#gameCanvas(width='960' height='540' hidden aria-label='Arène 2D. Flèches gauche et droite pour se déplacer, flèche haut pour sauter.' tabindex='0')
          #menuDepart.game-panel
            p.panel-kicker À deux, c’est mieux
            h2#waiting-title En attente du second joueur
            p#waiting-description Copiez l’invitation pour partager cette arène.
            p.nbJoueur
            button#btnDepart.button.cacher(type='button') Jouer
          #finPartie.game-panel
            p.panel-kicker Fin de manche
            h2 Partie terminée
            p#resultat
            .final-scores
              p#monScore
              p#autreScore
            p#replay-waiting
            .panel-actions
              button#replay-game.button.cacher(type='button') Rejouer
              button#terminer.button.is-outlined(type='button') Terminer
          p#renderer-notice.recovery-notice(hidden role='status')
        footer.arena-controls
          .touch-controls(aria-label='Commandes du joueur')
            button#move-left.button(type='button' aria-label='Se déplacer à gauche') ←
            button#move-right.button(type='button' aria-label='Se déplacer à droite') →
            button#jump-button.button(type='button' aria-label='Sauter')
              span.jump-arrow(aria-hidden='true') ↑
              span Sauter
            small.keyboard-hint ← → déplacer · ↑ sauter
          button#rules-toggle.button.is-outlined(type='button' aria-haspopup='dialog') Règles et bonus
        .arena-status
          p#game-status(role='status')
          button#retry-score.button.is-outlined.cacher(type='button') Réessayer l’enregistrement
        dialog#game-rules-panel.game-rules-panel(aria-labelledby='rules-title')
          .rules-heading
            h2#rules-title Règles et bonus
            button#close-rules.button.is-outlined(type='button' aria-label='Fermer les règles') Fermer
          p.rule-intro Deux joueurs, 90 secondes. Le meilleur score gagne.
          p.rule-controls ← → pour se déplacer, ↑ pour sauter. Vous pouvez traverser l’autre pilote et sauter par-dessus les blocs. Les objets tombent de plus en plus vite jusqu’à la fin.
          .rules-columns
            section
              h3 À ramasser
              ul.item-legend.points-guide
                li
                  img.legend-icon(src='/images/items/star.svg' alt='' width='38' height='48')
                  span Étoile · +1 point
                li
                  img.legend-icon(src='/images/items/gold.svg' alt='' width='38' height='48')
                  span Étoile dorée · +3 points
              h3 Bonus automatiques · 8 s maximum
              ul.item-legend
                li
                  img.legend-icon(src='/images/items/sprint.svg' alt='' width='38' height='48')
                  span Vitesse · déplacement 50 % plus rapide
                li
                  img.legend-icon(src='/images/items/multiplier.svg' alt='' width='38' height='48')
                  span Points ×2 · étoiles à +2 ou +6 points
                li
                  img.legend-icon(src='/images/items/shield.svg' alt='' width='38' height='48')
                  span Bouclier · protège du prochain obstacle, puis disparaît
                li
                  img.legend-icon(src='/images/items/magnet.svg' alt='' width='38' height='48')
                  span Aimant · ramasse les étoiles proches
            section
              h3 À éviter
              ul.item-legend
                li
                  img.legend-icon(src='/images/items/meteor.svg' alt='' width='38' height='48')
                  span Météorite · vous fait perdre 3 points
                li
                  img.legend-icon(src='/images/items/barrier.svg' alt='' width='38' height='48')
                  span Bloc · vous fait perdre 2 points. Sautez pour l’éviter.
                li
                  img.legend-icon(src='/images/items/slime.svg' alt='' width='38' height='48')
                  span Flaque collante · vitesse divisée par 2 pendant 4 s
              p Le bouclier bloque une météorite, un bloc ou une flaque. Le score ne descend jamais sous zéro. Un nouveau bonus remplace le précédent.
          p.rules-note Une coupure réserve votre place 12 secondes. Quitter met fin à la manche.
  script(src='/js/site.js')
  script(src='/js/jeuClient.js')
