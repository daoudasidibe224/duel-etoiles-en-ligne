include includes/head.pug
body
  include includes/header.pug
  main#contenu.auth-layout
    section.auth-card.console-frame(aria-labelledby='form-title')
      .console-label
        span NOUVEAU JOUEUR
        span.system-light Inscription
      h1#form-title Créer un compte
      p.muted Votre pseudo apparaîtra dans les salons et les scores.
      include includes/messages.pug
      form(action='/utilisateur/inscription' method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        .field
          label.label(for='nomUtilisateur') Pseudo
          input#nomUtilisateur.input(type='text' name='nomUtilisateur' required minlength='3' maxlength='24' pattern='[A-Za-z0-9_-]{3,24}' autocomplete='username' value=typeof nomUtilisateur !== 'undefined' ? nomUtilisateur : '' aria-describedby='pseudo-aide')
          p#pseudo-aide.help 3 à 24 lettres, chiffres, tirets ou tirets bas.
        .field
          label.label(for='email') Adresse email
          input#email.input(type='email' name='email' required maxlength='254' autocomplete='email' value=typeof email !== 'undefined' ? email : '')
        .field
          label.label(for='mdp') Mot de passe
          input#mdp.input(type='password' name='mdp' required minlength='8' maxlength='72' autocomplete='new-password' aria-describedby='mdp-aide')
          p#mdp-aide.help Au moins 8 caractères, au maximum 72 octets.
        .field
          label.label(for='mdp2') Confirmer le mot de passe
          input#mdp2.input(type='password' name='mdp2' required minlength='8' maxlength='72' autocomplete='new-password')
        button.button.is-primary.is-fullwidth(type='submit') Créer mon compte →
      p.form-foot Déjà un compte ?
        a(href='/connexion') Se connecter
  include includes/footer.pug
